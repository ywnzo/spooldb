{
  "name": "spooldb",
  "version": "0.4.38",
  "private": true,
  "description": "Local-first code and conversation history, independent of agent harnesses",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./relay": {
      "types": "./src/relay/index.d.ts",
      "default": "./src/relay/index.js"
    },
    "./adapters": {
      "types": "./src/adapters/index.d.ts",
      "default": "./src/adapters/index.js"
    }
  },
  "bin": {
    "spool": "./src/cli.js",
    "spool-relay": "./src/relay-cli.js",
    "spool-sync": "./src/sync-cli.js",
    "spool-project": "./src/project-cli.js",
    "spool-memory-mcp": "./src/memory-mcp.js",
    "spool-host": "./src/team-host.js"
  },
  "scripts": {
    "build:installer": "bun scripts/build-linux-installer.js",
    "test": "SPOOL_EMBEDDINGS=off bun test --timeout 30000 test/",
    "demo": "bun examples/offline-merge.js",
    "demo:git": "bun examples/git-bridge.js",
    "demo:review": "bun examples/review-demo.js",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit --strict --module nodenext --target es2024 test/types/adapters.ts",
    "benchmark": "bun benchmarks/run.js",
    "benchmark:large": "bun benchmarks/run.js --large --no-gc --output=benchmarks/large-results.json",
    "benchmark:million": "bun benchmarks/million.js",
    "benchmark:relay": "bun benchmarks/relay.js",
    "benchmark:retrieval": "bun benchmarks/retrieval.js --output=work/retrieval-results.json",
    "test:bun": "SPOOL_EMBEDDINGS=off bun test --timeout 30000 test/",
    "test:cloudflare": "SPOOL_EMBEDDINGS=off bun test --timeout 30000 test/cloudflare.test.js test/remote-mcp.test.js",
    "deploy:cloudflare": "bun src/cli.js deploy cloudflare",
    "generate:schemas": "bun scripts/generate-event-validator.js",
    "build:cloudflare": "bun node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir work/cloudflare-build",
    "build:downloads": "bun scripts/build-download-assets.js",
    "generate:memory-schemas": "bun scripts/generate-memory-validators.js",
    "build:plugin": "bun scripts/build-codex-plugin.js",
    "benchmark:quality": "bun benchmarks/retrieval-quality.js",
    "benchmark:vectors": "bun benchmarks/vector-scale.js"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@huggingface/transformers": "3.8.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "miniflare": "5.20261019.2-beta",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  },
  "imports": {
    "#spool-local-embeddings": {
      "workerd": "./src/memory/no-local-embeddings.js",
      "default": "./src/memory/local-embeddings.js"
    },
    "#spool-sqlite": {
      "workerd": "./src/cloudflare/no-node-sqlite.js",
      "default": "./src/sqlite.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ywnzo/spooldb.git"
  },
  "homepage": "https://github.com/ywnzo/spooldb",
  "bugs": {
    "url": "https://github.com/ywnzo/spooldb/issues"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
