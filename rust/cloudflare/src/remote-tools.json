  {
    "name": "project_context",
    "description": "Retrieve relevant project evidence using a natural-language description of the current task. Local relays combine semantic and exact-word retrieval. Check retrieval.semanticStatus for model readiness, read memory_get only for missing detail or provenance, and check Git reconciliation before trusting code claims. Reuse sufficient context until the task or repository changes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Project ID from project_list (or an unambiguous exact project name). Required for workspace connections. Use the project for the repository currently being worked on."
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "query": {
          "type": "string",
          "maxLength": 1000
        },
        "includeArchived": {
          "type": "boolean",
          "description": "Include archived, resolved and superseded records and completed tasks. Uses keyword retrieval; full sources remain available with memory_get."
        },
        "compact": {
          "type": "boolean",
          "description": "Defaults to true: budgeted source cards. Read memory_get only for missing detail; false returns the full search envelope."
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 24000,
          "description": "Compact response character budget; default 6000. This is not a model-specific token count."
        },
        "mode": {
          "enum": [
            "hybrid",
            "keyword"
          ],
          "description": "Default hybrid ranks a bounded candidate set. Keyword mode retains exhaustive lexical pagination."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "memory:read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "memory:read"
          ]
        }
      ]
    }
  },
