[
  {
    "name": "project_list",
    "description": "List projects this connection can access. Select the project matching the current repository; ask if ambiguous. Pass its ID as project on every memory call. Never infer a target from another chat.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "memory:read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "memory:read"
          ]
        }
      ]
    }
