  {
    "name": "handoff",
    "description": "Update the current task handoff only when results, verification, next steps or blockers materially change. Same-task, same-author saves supersede the prior active handoff while preserving history; identical evidence is a no-op. Keep the replacement self-contained. Skip routine replies and unchanged status. This does not mark the task done. Keep title, summary, next steps and blockers within 2,000 characters combined (summary at most 1,500; title 120; at most 3 next steps and 3 blockers, 160 characters each). Aim for a short status, essential validation and the next action. Save detailed evidence/runbooks as separate findings or decisions and cite their IDs in refs. Do not repeat the conversation or split one recap across multiple handoffs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Project ID from project_list (or an unambiguous exact project name). Required for workspace connections. Use the project for the repository currently being worked on."
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "nextSteps": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "supersedes": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "IDs superseded by this evidence; history is preserved."
        },
        "resolves": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "IDs resolved by this verified evidence."
        },
        "files": {
