  {
    "name": "memory_get",
    "description": "Retrieve a cited memory/conversation record, including provenance, Git references and Git references (checkout reconciliation requires a local companion). Text is paginated; follow nextOffset for long records.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Project ID from project_list (or an unambiguous exact project name). Required for workspace connections. Use the project for the repository currently being worked on."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "sourceProject": {
          "enum": [
            "current",
            "parent"
          ],
          "description": "Choose parent to read a cited parent result."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "memory:read"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "memory:read"
          ]
        }
      ]
    }
  },
  {
    "name": "memory_update",
    "description": "Archive, restore, resolve or supersede a cited record without deleting its history. First read memory_get and pass lifecycle.revision. Explain the evidence; do not archive solely because similarity is low.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Project ID from project_list (or an unambiguous exact project name). Required for workspace connections. Use the project for the repository currently being worked on."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action": {
          "enum": [
            "archive",
            "restore",
            "resolve",
            "supersede"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "replacementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resolveIds": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable retry key."
        }
      },
      "required": [
        "id",
        "action",
        "reason",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "memory:read",
          "memory:write"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "memory:read",
            "memory:write"
          ]
        }
      ]
    }
  },
  {
    "name": "task_update",
    "description": "Create, claim, progress or complete a meaningful shared task when work or a concrete continuation warrants it; skip routine replies and generic session placeholders. Use a specific title, current status and actionable summary. Use the current revision from lifecycle context or the latest successful update; retrieve it if missing or after a conflict. expectedRevision=0 creates it. Stale writes fail rather than replacing another agent’s work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Project ID from project_list (or an unambiguous exact project name). Required for workspace connections. Use the project for the repository currently being worked on."
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "blocked",
            "done"
          ]
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "resolveIds": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "supersedes": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "IDs superseded by this evidence; history is preserved."
        },
        "resolves": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "IDs resolved by this verified evidence."
        },
        "files": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Project-relative paths; shared memory stores Git references, not files."
        },
        "commits": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Relevant full Git commit IDs."
        },
        "refs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Source IDs from this project."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable retry key."
        }
      },
      "required": [
        "taskId",
        "title",
        "text",
        "status",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "memory:read",
          "memory:write"
        ]
      }
    ],
    "_meta": {
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "memory:read",
            "memory:write"
          ]
        }
      ]
    }
  },
