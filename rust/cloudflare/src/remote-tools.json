          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Project-relative paths; shared memory stores Git references, not files."
        },
        "commits": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Relevant full Git commit IDs."
        },
        "refs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "description": "Source IDs from this project."
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable retry key."
        }
