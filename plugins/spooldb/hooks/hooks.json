{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/spool.sh\" hook SessionStart",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Suggest project memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/spool.sh\" hook UserPromptSubmit",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Suggest relevant memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/spool.sh\" hook Stop",
            "timeout": 60,
            "statusMessage": "SpoolDB: Finish hook (no action)"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/spool.sh\" hook Interrupt",
            "timeout": 3,
            "statusMessage": "SpoolDB: Interrupt hook (no action)"
          }
        ]
      }
    ]
  },
  "description": "SpoolDB optional project memory guidance"
}
