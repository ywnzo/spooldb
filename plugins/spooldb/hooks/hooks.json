{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/82600c45051751a224f583ffa8e91c3326ca23f68289008267784b164205fadc/run.sh\" SessionStart",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Load project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/82600c45051751a224f583ffa8e91c3326ca23f68289008267784b164205fadc/run.sh\" UserPromptSubmit",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Retrieve relevant memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/82600c45051751a224f583ffa8e91c3326ca23f68289008267784b164205fadc/run.sh\" Stop",
            "timeout": 60,
            "statusMessage": "SpoolDB: Save handoff"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/82600c45051751a224f583ffa8e91c3326ca23f68289008267784b164205fadc/run.sh\" Interrupt",
            "timeout": 3,
            "statusMessage": "SpoolDB: Save interrupted checkpoint"
          }
        ]
      }
    ]
  },
  "description": "SpoolDB shared project memory and handoff automation"
}
