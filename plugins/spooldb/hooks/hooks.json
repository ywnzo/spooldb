          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/b8cfeb6e491c65da16f69d2ec4d1af19d3064f9553544a0e442941ab7a496c5a/run.sh\" Interrupt",
