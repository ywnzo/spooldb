{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/d3b5a57a4e776fa4f9a64cee5b1e6a4eb8855e9c2a505b6f4bc6f3e343edd43e/run.sh\" SessionStart",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Load project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/d3b5a57a4e776fa4f9a64cee5b1e6a4eb8855e9c2a505b6f4bc6f3e343edd43e/run.sh\" UserPromptSubmit",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Retrieve relevant memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/d3b5a57a4e776fa4f9a64cee5b1e6a4eb8855e9c2a505b6f4bc6f3e343edd43e/run.sh\" Stop",
            "timeout": 60,
            "statusMessage": "SpoolDB: Save handoff"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/d3b5a57a4e776fa4f9a64cee5b1e6a4eb8855e9c2a505b6f4bc6f3e343edd43e/run.sh\" Interrupt",
            "timeout": 3,
            "statusMessage": "SpoolDB: Save interrupted checkpoint"
          }
        ]
      }
    ]
  },
  "description": "SpoolDB shared project memory and handoff automation"
}
