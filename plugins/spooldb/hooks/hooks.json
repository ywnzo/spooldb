{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/483dd9d14bd26f93fef5e532b98123629edf26400eeaefdbe2d3d874974b96c3/run.sh\" SessionStart",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Load project context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/483dd9d14bd26f93fef5e532b98123629edf26400eeaefdbe2d3d874974b96c3/run.sh\" UserPromptSubmit",
            "timeout": 60,
            "additionalContextLimit": 7000,
            "statusMessage": "SpoolDB: Retrieve relevant memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/483dd9d14bd26f93fef5e532b98123629edf26400eeaefdbe2d3d874974b96c3/run.sh\" Stop",
            "timeout": 60,
            "statusMessage": "SpoolDB: Save handoff"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${XDG_DATA_HOME:-$HOME/.local/share}/spool/codex-hooks/483dd9d14bd26f93fef5e532b98123629edf26400eeaefdbe2d3d874974b96c3/run.sh\" Interrupt",
            "timeout": 3,
            "statusMessage": "SpoolDB: Save interrupted checkpoint"
          }
        ]
      }
    ]
  },
  "description": "SpoolDB shared project memory and handoff automation"
}
